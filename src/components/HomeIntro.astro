---
import type { Lang } from '../types';
import { profile } from '../data/profile';
const { lang } = Astro.props as { lang: Lang };
const label = {
  en: 'Academic Homepage',
  zh: '个人学术主页',
  ja: '個人学術ホームページ'
};
const place = {
  en: 'Hokkaido University · Sapporo, Japan',
  zh: '北海道大学 · 日本札幌',
  ja: '北海道大学・札幌'
};
---
<div class="home-intro" data-home-intro aria-hidden="true">
  <div class="home-intro-inner">
    <div class="home-intro-scene" role="presentation">
      <div class="intro-moon"></div>
      <div class="intro-sakura intro-sakura-a"></div>
      <div class="intro-sakura intro-sakura-b"></div>
      <svg class="intro-ridges" viewBox="0 0 320 110">
        <path d="M0 78 C26 66 42 44 60 38 C78 33 88 49 104 50 C120 51 132 26 154 22 C182 17 188 47 214 49 C236 50 248 31 268 29 C289 27 304 41 320 56" />
        <path d="M0 90 C35 84 58 64 82 59 C104 55 122 69 143 70 C167 71 182 51 204 48 C228 45 248 57 267 60 C289 64 305 72 320 80" />
      </svg>
      <div class="intro-ground"></div>
    </div>
    <p class="home-intro-kicker">SAPPORO · HOKKAIDO · JAPAN</p>
    <div class="home-intro-name"><span>MINGRUI</span><span>ZHENG</span></div>
    <div class="home-intro-rule"></div>
    <p class="home-intro-localized">{profile.displayName[lang]} · {label[lang]}</p>
    <p class="home-intro-place">{place[lang]}</p>
  </div>
</div>
<script is:inline>
  (() => {
    let intro = document.querySelector('[data-home-intro]');
    if (!intro) return;

    let timers = [];
    const clearTimers = () => {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
    };

    const playIntro = ({ restored = false } = {}) => {
      clearTimers();

      // Safari may restore the homepage from BFCache with the previous intro state.
      // Cloning restarts the CSS animation timeline without storing a one-time flag.
      if (restored && intro?.parentNode) {
        const fresh = intro.cloneNode(true);
        intro.parentNode.replaceChild(fresh, intro);
        intro = fresh;
      }

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      intro.classList.remove('is-leaving', 'is-gone', 'home-intro-reduced');
      intro.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('home-intro-active');

      // Respect the OS accessibility preference, but do not make the intro flash away.
      // In reduced-motion mode we keep the cover visible briefly, then reveal the page.
      if (reduce) intro.classList.add('home-intro-reduced');

      const leaveAt = reduce ? 1200 : 1850;
      const hideAt = reduce ? 1450 : 2350;

      timers.push(window.setTimeout(() => {
        intro?.classList.add('is-leaving');
        document.documentElement.classList.remove('home-intro-active');
      }, leaveAt));

      timers.push(window.setTimeout(() => {
        intro?.classList.add('is-gone');
        intro?.setAttribute('aria-hidden', 'true');
      }, hideAt));
    };

    playIntro();

    // Back/forward navigation on mobile Safari can restore a frozen DOM snapshot.
    // Replay the intro when the homepage is restored from BFCache.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) playIntro({ restored: true });
    });
  })();
</script>
