---
import type { Lang } from '../types';
const { lang } = Astro.props as { lang: Lang };
const L = (en:string, zh:string, ja:string) => ({ en, zh, ja });

const t = {
  eyebrow: L('RESEARCH WORKFLOW','研究流程','研究ワークフロー'),
  title: L('From optimization model to deployable AI solver','从最优化模型到可部署的 AI 求解器','最適化モデルから実運用可能なAIソルバへ'),
  intro: L(
    'The animation below shows the workflow I repeatedly use in learning-augmented optimization: formulate the problem, obtain expert solutions with an exact solver, learn the solution map with a neural network, repair the prediction to satisfy hard constraints, and compare it with the optimum.',
    '下面的动画展示了我在学习增强优化中反复使用的一条主线：提出最优化问题，用精确算法获取专家最优解，利用神经网络学习“状态→解”的映射，对预测解进行规范化与可行性修复，最后与最优解比较。',
    '以下のアニメーションは、学習拡張型最適化で繰り返し用いる流れを示します。最適化問題を定式化し、厳密ソルバで専門家解を取得し、ニューラルネットワークで「状態→解」の写像を学習し、予測解を制約に適合するよう修復した後、最適解と比較します。'
  ),
  play: L('Play','播放','再生'),
  pause: L('Pause','暂停','一時停止'),
  replay: L('Replay','重播','リプレイ'),
  current: L('Current stage','当前阶段','現在の段階'),
  scenes: [
    { key:'formulate', short:L('Formulate','建模','定式化'), title:L('Formulate the optimization problem','提出最优化问题','最適化問題を定式化'), desc:L('Convert a networked-system task into decision variables, objective functions, and hard constraints.','把网络化系统任务转化为决策变量、目标函数和硬约束。','ネットワーク化システムの課題を、意思決定変数・目的関数・ハード制約へ変換します。') },
    { key:'expert', short:L('Expert solver','专家求解','専門家ソルバ'), title:L('Compute expert optimal solutions','用精确算法求专家解','厳密アルゴリズムで専門家解を求める'), desc:L('Solve representative instances with MPC, MILP/MINLP, decomposition, or other exact/near-exact algorithms.','用 MPC、MILP/MINLP、分解等精确或近精确算法求解代表性实例。','MPC、MILP/MINLP、分解法などの厳密・準厳密アルゴリズムで代表的なインスタンスを解きます。') },
    { key:'dataset', short:L('Expert dataset','专家数据集','専門家データ'), title:L('Build the expert dataset','构建专家数据集','専門家データセットを構築'), desc:L('Pair every system state s with its expert solution x* to create supervised training data.','将每个系统状态 s 与对应的专家解 x* 配对，得到监督学习数据集。','各システム状態 s と専門家解 x* を対応付け、教師あり学習データを構築します。') },
    { key:'train', short:L('Train network','训练网络','ネットワーク学習'), title:L('Learn the state-to-solution map','训练神经网络学习状态到解的映射','状態から解への写像を学習'), desc:L('Forward activations produce a candidate solution; the expert target generates loss; gradients propagate backward to update weights.','前向传播生成候选解，专家解作为监督目标计算损失，再通过反向传播更新权重。','順伝播で候補解を生成し、専門家解との損失を計算し、逆伝播で重みを更新します。') },
    { key:'repair', short:L('Repair','可行性修复','実行可能化'), title:L('Normalize and repair the predicted solution','规范化预测解并修复约束','予測解を正規化・修復'), desc:L('Projection, clipping, rounding, rebalancing, or a lightweight repair problem converts x-hat into a feasible x-tilde.','通过投影、截断、取整、再平衡或轻量修复问题，将 x̂ 转换为满足约束的 x̃。','射影、クリッピング、丸め、再配分、軽量修復問題により x̂ を実行可能な x̃ に変換します。') },
    { key:'compare', short:L('Compare','最优性对比','最適解比較'), title:L('Compare with the optimal solution','与最优解进行对比','最適解と比較'), desc:L('Measure optimality gap, feasibility, latency, and robustness: the goal is near-optimal quality at dramatically lower online cost.','比较最优性差距、可行性、时延与鲁棒性：目标是在显著降低在线求解开销的同时保持近最优质量。','最適性ギャップ、実行可能性、遅延、ロバスト性を比較し、オンライン計算量を大幅に削減しつつ準最適性能を維持します。') }
  ],
  labels: {
    state: L('system state s','系统状态 s','システム状態 s'),
    objective: L('objective','目标','目的関数'),
    constraints: L('constraints','约束','制約'),
    exact: L('exact / expert solver','精确 / 专家求解器','厳密 / 専門家ソルバ'),
    optimum: L('optimal solution x*','最优解 x*','最適解 x*'),
    samples: L('expert samples','专家样本','専門家サンプル'),
    train: L('train','训练','学習'),
    val: L('validation','验证','検証'),
    test: L('test','测试','テスト'),
    features: L('input features','输入特征','入力特徴'),
    hidden1: L('hidden layer 1','隐藏层 1','中間層 1'),
    hidden2: L('hidden layer 2','隐藏层 2','中間層 2'),
    output: L('output neurons','输出神经元','出力ニューロン'),
    forward: L('forward pass','前向传播','順伝播'),
    loss: L('imitation + constraint loss','模仿 + 约束损失','模倣 + 制約損失'),
    backward: L('backpropagation','反向传播','逆伝播'),
    candidate: L('candidate x-hat','候选解 x̂','候補解 x̂'),
    repair: L('feasibility repair','可行性修复','実行可能化修復'),
    feasible: L('feasible x-tilde','可行解 x̃','実行可能解 x̃'),
    violated: L('violated','违反','違反'),
    satisfied: L('satisfied','满足','満足'),
    metric: L('metric','指标','指標'),
    exactCol: L('Exact','精确算法','厳密解法'),
    aiCol: L('AI + Repair','AI + 修复','AI + 修復'),
    gap: L('Optimality gap','最优性差距','最適性ギャップ'),
    feasibleRate: L('Feasibility','可行性','実行可能性'),
    runtime: L('Online runtime','在线求解时间','オンライン計算時間'),
    optimumQuality: L('reference optimum','最优基准','最適基準'),
    nearOptimal: L('near-optimal','近最优','準最適'),
    slow: L('heavy optimization','高开销求解','高計算コスト'),
    fast: L('fast inference','快速推理','高速推論'),
    repairOps: [L('projection','投影','射影'),L('clipping','截断','クリッピング'),L('rounding','取整','丸め'),L('repair LP','修复 LP','修復 LP')],
    predicted: L('predicted solution','预测解','予測解'),
    gradNorm: L('gradient norm','梯度范数','勾配ノルム'),
    learnRate: L('learning rate','学习率','学習率'),
    batch: L('mini-batch','小批量','ミニバッチ'),
    repairNotes: [
      L('Step 1: project the power variable onto the feasible boundary P = 1.00.','步骤 1：将功率变量投影到可行边界 P = 1.00。','ステップ1：電力変数を可行境界 P = 1.00 に射影します。'),
      L('Step 2: clip the energy variable so that the battery state stays nonnegative.','步骤 2：对能量变量做截断，保证电池状态非负。','ステップ2：エネルギー変数をクリップし、バッテリ状態を非負に保ちます。'),
      L('Step 3: round the binary decision y to the nearest feasible discrete value.','步骤 3：将二进制决策 y 取整到最近的可行离散值。','ステップ3：二値決定 y を最も近い可行な離散値へ丸めます。'),
      L('Step 4: solve a lightweight repair LP to rebalance time allocation and satisfy the total budget.','步骤 4：求解一个轻量修复 LP，重新平衡时间分配并满足总时长预算。','ステップ4：軽量な修復LPを解き、時間配分を再調整して総予算制約を満たします。')
    ]
  }
};
---
<section class="section-shell optimization-demo-section" data-reveal>
  <div class="research-section-split optimization-demo-heading">
    <div><p class="eyebrow">03 / INTERACTIVE METHOD</p><h2>{t.title[lang]}</h2></div>
    <p>{t.intro[lang]}</p>
  </div>

  <div class="optimization-demo" data-optimization-demo data-step="0" data-repair-notes={JSON.stringify(t.labels.repairNotes.map(item => item[lang]))}>
    <div class="optimization-demo-topbar">
      <div class="demo-status">
        <span class="demo-live-dot"></span>
        <span>{t.current[lang]}</span>
        <strong data-stage-label>{t.scenes[0].short[lang]}</strong>
      </div>
      <div class="demo-controls" aria-label="Animation controls">
        <button type="button" data-demo-play aria-label={t.play[lang]}>▶ <span>{t.play[lang]}</span></button>
        <button type="button" data-demo-pause aria-label={t.pause[lang]}>Ⅱ <span>{t.pause[lang]}</span></button>
        <button type="button" data-demo-replay aria-label={t.replay[lang]}>↻ <span>{t.replay[lang]}</span></button>
      </div>
    </div>

    <div class="demo-progress-rail" aria-hidden="true"><span data-demo-progress></span></div>

    <nav class="demo-stage-nav" aria-label="Animation stages">
      {t.scenes.map((scene, i) => (
        <button type="button" data-demo-step={i} class={i === 0 ? 'active' : ''}>
          <span>{String(i + 1).padStart(2,'0')}</span>
          <b>{scene.short[lang]}</b>
        </button>
      ))}
    </nav>

    <div class="demo-viewport">
      <div class="demo-scene scene-formulate is-active" data-scene="0">
        <div class="scene-copy">
          <span class="scene-number">01</span>
          <p class="eyebrow">FORMULATE</p>
          <h3>{t.scenes[0].title[lang]}</h3>
          <p>{t.scenes[0].desc[lang]}</p>
        </div>
        <div class="formulate-stage">
          <div class="system-canvas">
            <span class="uav-symbol uav-a">UAV</span>
            <span class="uav-symbol uav-b">UAV</span>
            <span class="device-symbol dev-a">D1</span><span class="device-symbol dev-b">D2</span><span class="device-symbol dev-c">D3</span>
            <span class="system-link link-1"></span><span class="system-link link-2"></span><span class="system-link link-3"></span><span class="system-link link-4"></span>
            <span class="packet packet-a"></span><span class="packet packet-b"></span>
          </div>
          <div class="model-stack">
            <div><small>{t.labels.state[lang]}</small><strong class="formula-text">s = [h, E, q, γ, ⋯]</strong></div>
            <div><small>{t.labels.objective[lang]}</small><strong class="formula-text">minₓ f(x; s)</strong></div>
            <div><small>{t.labels.constraints[lang]}</small><strong class="formula-text">g(x; s) ≤ 0  ·  h(x; s) = 0</strong></div>
          </div>
        </div>
      </div>

      <div class="demo-scene scene-expert" data-scene="1">
        <div class="scene-copy">
          <span class="scene-number">02</span>
          <p class="eyebrow">EXPERT SOLVER</p>
          <h3>{t.scenes[1].title[lang]}</h3>
          <p>{t.scenes[1].desc[lang]}</p>
        </div>

        <div class="expert-stage expert-stage-v2">
          <aside class="expert-instance expert-panel expert-instance-v2">
            <div class="expert-panel-kicker">INSTANCE</div>
            <div class="expert-state-symbol">sᵢ</div>
            <small>{t.labels.state[lang]}</small>
            <div class="expert-state-list formula-text">
              <div><b>h</b><em>0.82</em></div>
              <div><b>E</b><em>0.41</em></div>
              <div><b>q</b><em>3</em></div>
              <div><b>γ</b><em>0.76</em></div>
            </div>
            <div class="expert-mini-formula formula-text">
              <span>minₓ f(x; sᵢ)</span>
              <span>s.t. g(x; sᵢ) ≤ 0</span>
            </div>
          </aside>

          <div class="expert-flow-arrow expert-flow-in" aria-hidden="true"><span></span><i></i></div>

          <div class="solver-box solver-box-v2">
            <div class="solver-header solver-header-v2">
              <div>
                <span>{t.labels.exact[lang]}</span>
                <strong>Mixed-Integer Expert Solver</strong>
              </div>
              <div class="solver-mode-tabs"><b>MILP / MINLP</b><span>MPC horizon</span></div>
            </div>

            <div class="solver-workspace">
              <div class="bb-panel">
                <div class="solver-subtitle">Branch-and-Bound Search</div>
                <svg class="bb-tree" viewBox="0 0 560 310" role="img" aria-label="Branch-and-bound tree">
                  <g class="bb-edges">
                    <path d="M280 34 L165 102"/><path d="M280 34 L395 102"/>
                    <path d="M165 102 L92 180"/><path d="M165 102 L232 180"/>
                    <path d="M395 102 L330 180"/><path d="M395 102 L470 180"/>
                    <path d="M92 180 L58 258"/><path d="M92 180 L128 258"/>
                    <path d="M330 180 L300 258"/><path d="M330 180 L365 258"/>
                  </g>
                  <g class="bb-branch-labels formula-text">
                    <text x="202" y="64">y₃ = 0</text><text x="342" y="64">y₃ = 1</text>
                    <text x="105" y="144">y₅ = 0</text><text x="204" y="144">y₅ = 1</text>
                    <text x="347" y="144">y₂ = 0</text><text x="438" y="144">y₂ = 1</text>
                  </g>
                  <g class="bb-node" data-bb-node="0" transform="translate(280 34)"><circle r="22"/><text y="0">N0</text><text class="bb-bound" y="36">0.620</text></g>
                  <g class="bb-node" data-bb-node="1" transform="translate(165 102)"><circle r="21"/><text y="0">N1</text><text class="bb-bound" y="35">0.731</text></g>
                  <g class="bb-node" data-bb-node="2" transform="translate(395 102)"><circle r="21"/><text y="0">N2</text><text class="bb-bound" y="35">0.754</text></g>
                  <g class="bb-node" data-bb-node="3" transform="translate(92 180)"><circle r="20"/><text y="0">N3</text><text class="bb-bound" y="34">0.812</text></g>
                  <g class="bb-node" data-bb-node="4" transform="translate(232 180)"><circle r="20"/><text y="0">N4</text><text class="bb-bound" y="34">∞</text></g>
                  <g class="bb-node" data-bb-node="5" transform="translate(330 180)"><circle r="20"/><text y="0">N5</text><text class="bb-bound" y="34">0.801</text></g>
                  <g class="bb-node" data-bb-node="6" transform="translate(470 180)"><circle r="20"/><text y="0">N6</text><text class="bb-bound" y="34">0.990</text></g>
                  <g class="bb-node leaf" data-bb-node="7" transform="translate(58 258)"><circle r="18"/><text y="0">N7</text><text class="bb-bound" y="32">1.013</text></g>
                  <g class="bb-node leaf" data-bb-node="8" transform="translate(128 258)"><circle r="18"/><text y="0">N8</text><text class="bb-bound" y="32">0.984</text></g>
                  <g class="bb-node leaf" data-bb-node="9" transform="translate(300 258)"><circle r="18"/><text y="0">N9</text><text class="bb-bound" y="32">0.991</text></g>
                  <g class="bb-node leaf" data-bb-node="10" transform="translate(365 258)"><circle r="18"/><text y="0">N10</text><text class="bb-bound" y="32">0.981</text></g>
                  <g class="bb-status-labels">
                    <text x="232" y="214" class="bb-pruned-label">infeasible</text>
                    <text x="470" y="214" class="bb-pruned-label">bound</text>
                    <text x="128" y="307" class="bb-incumbent-label">incumbent</text>
                  </g>
                </svg>
                <div class="bb-legend">
                  <span><i class="legend-active"></i> active</span>
                  <span><i class="legend-visited"></i> explored</span>
                  <span><i class="legend-incumbent"></i> incumbent</span>
                  <span><i class="legend-pruned"></i> pruned</span>
                </div>
              </div>

              <aside class="solver-trace-panel">
                <div class="solver-mini-metrics">
                  <div><span>processed node</span><strong data-nodecount>01 / 32</strong></div>
                  <div><span>incumbent UB</span><strong data-incumbent>1.310</strong></div>
                  <div><span>best bound LB</span><strong data-bestbound>0.620</strong></div>
                  <div><span>MIP gap</span><strong data-gap>52.7%</strong></div>
                </div>
                <div class="solver-gapbar"><i data-gapbar></i></div>
                <div class="bb-log" data-bb-log>
                  <p><b>01</b><span>solve LP relaxation at N0</span></p>
                  <p><b>02</b><span>branch on fractional y₃</span></p>
                  <p><b>03</b><span>update incumbent</span></p>
                  <p><b>04</b><span>prune by infeasibility / bound</span></p>
                </div>
                <div class="solver-iterations">
                  <div><span>LB</span><em data-lb>0.620</em></div>
                  <div><span>UB</span><em data-ub>1.310</em></div>
                  <div><span>gap</span><em data-gap-bottom>52.7%</em></div>
                </div>
              </aside>
            </div>

            <div class="mpc-horizon-strip">
              <div class="mpc-strip-head"><span>MPC receding horizon</span><b>k → k+H</b></div>
              <div class="mpc-cells">
                {Array.from({length:8}).map((_,i)=><div class="mpc-cell" data-mpc-cell={i}><small>{i===0?'k':`k+${i}`}</small><span></span><em></em></div>)}
              </div>
              <div class="mpc-legend"><span><i></i> state xₜ</span><span><i></i> control uₜ</span><strong>apply first control → shift horizon</strong></div>
            </div>
          </div>

          <div class="expert-flow-arrow expert-flow-out" aria-hidden="true"><span></span><i></i></div>

          <aside class="expert-solution expert-panel expert-result-v2">
            <div class="expert-panel-kicker">OPTIMUM</div>
            <div class="expert-result-symbol">x*</div>
            <small>{t.labels.optimum[lang]}</small>
            <div class="solution-vector formula-text">[1, 0, 0.74, 0.21, 1]</div>
            <div class="solution-details">
              <div><small>objective</small><strong class="formula-text">0.984</strong></div>
              <div><small>feasible</small><strong>✓</strong></div>
              <div><small>solve time</small><strong>38.6 s</strong></div>
            </div>
          </aside>
        </div>
      </div>

      <div class="demo-scene scene-dataset" data-scene="2">
        <div class="scene-copy">
          <span class="scene-number">03</span>
          <p class="eyebrow">EXPERT DATA</p>
          <h3>{t.scenes[2].title[lang]}</h3>
          <p>{t.scenes[2].desc[lang]}</p>
        </div>
        <div class="dataset-stage">
          <div class="dataset-table">
            <div class="dataset-head"><span>#</span><span>s</span><span>x*</span><span>split</span></div>
            {Array.from({length:7}).map((_,i) => (
              <div class="dataset-row" style={`--row:${i}`}><span>{String(i+1).padStart(2,'0')}</span><span>[{(0.12+i*.09).toFixed(2)}, {(0.81-i*.07).toFixed(2)}, …]</span><span>[{i%2}, {(0.67+i*.03).toFixed(2)}, …]</span><span>{i<5?t.labels.train[lang]:i===5?t.labels.val[lang]:t.labels.test[lang]}</span></div>
            ))}
          </div>
          <div class="dataset-counter"><strong data-sample-count>0</strong><span>{t.labels.samples[lang]}</span><small>D = &#123;(sᵢ, xᵢ*)&#125;</small></div>
        </div>
      </div>

      <div class="demo-scene scene-train" data-scene="3">
        <div class="scene-copy">
          <span class="scene-number">04</span>
          <p class="eyebrow">TRAIN</p>
          <h3>{t.scenes[3].title[lang]}</h3>
          <p>{t.scenes[3].desc[lang]}</p>
        </div>

        <div class="training-stage training-stage-v2" data-train-phase="input">
          <aside class="training-console">
            <div class="training-console-head"><span>SUPERVISED IMITATION</span><b data-train-phase-label>FORWARD / INPUT</b></div>
            <div class="target-pair">
              <div><small>expert target</small><strong class="formula-text" data-train-target>x* = [1, 0, 0.74, 0.21]</strong></div>
              <div><small>{t.labels.predicted[lang]}</small><strong class="formula-text" data-train-pred>x̂ = [0.91, 0.08, 0.69, 0.26]</strong></div>
            </div>
            <div class="training-metric-grid training-metric-grid-v2">
              <div><small>{t.labels.loss[lang]}</small><b data-train-loss>0.842</b></div>
              <div><small>epoch</small><b data-train-epoch>01 / 60</b></div>
              <div><small>{t.labels.gradNorm[lang]}</small><b data-train-grad>1.82</b></div>
              <div><small>{t.labels.learnRate[lang]}</small><b data-train-lr>1e−3</b></div>
            </div>
            <div class="train-equation formula-text">𝓛 = ‖x̂ − x*‖²₂ + λ·φ(x̂)</div>
            <div class="weight-update formula-text" data-weight-update>θ ← θ − η∇θ𝓛</div>
            <div class="mini-batch-card">
              <span>{t.labels.batch[lang]} Bₜ</span>
              <div>{Array.from({length:6}).map((_,i)=><i style={`--batch:${i}`}></i>)}</div>
              <small data-train-batch-caption>64 expert state–solution pairs</small>
            </div>
          </aside>

          <div class="network-stage network-stage-v2">
            <div class="network-phase-bar">
              <span data-phase-chip="input">01 input</span>
              <span data-phase-chip="h1">02 hidden 1</span>
              <span data-phase-chip="h2">03 hidden 2</span>
              <span data-phase-chip="output">04 output</span>
              <span data-phase-chip="loss">05 loss</span>
              <span data-phase-chip="backward">06 backprop</span>
            </div>

            <div class="network-labels network-labels-v2"><span>{t.labels.features[lang]}</span><span>{t.labels.hidden1[lang]}</span><span>{t.labels.hidden2[lang]}</span><span>{t.labels.output[lang]}</span></div>

            <svg class="network-svg network-svg-v2" viewBox="0 0 760 320" role="img" aria-label="Animated neural network forward and backward propagation">
              <defs>
                <filter id="nnGlow"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
              </defs>
              <g class="nn-edge-group edge-input-h1">
                {Array.from({length:6}).map((_,i) => Array.from({length:7}).map((__,j)=><line x1="80" y1={42+i*44} x2="285" y2={28+j*38}></line>))}
              </g>
              <g class="nn-edge-group edge-h1-h2">
                {Array.from({length:7}).map((_,i) => Array.from({length:6}).map((__,j)=><line x1="300" y1={28+i*38} x2="505" y2={47+j*44}></line>))}
              </g>
              <g class="nn-edge-group edge-h2-out">
                {Array.from({length:6}).map((_,i) => Array.from({length:4}).map((__,j)=><line x1="520" y1={47+i*44} x2="700" y2={78+j*58}></line>))}
              </g>

              <g class="nn-layer layer-input">
                {Array.from({length:6}).map((_,i)=><g class="nn-neuron" data-layer="input" data-neuron={i}><circle cx="80" cy={42+i*44} r="13"></circle><text x="54" y={46+i*44} text-anchor="end">{['h','E','q','γ','τ','c'][i]}</text><text x="101" y={46+i*44}>{['.72','.18','.91','.43','.66','.27'][i]}</text></g>)}
              </g>
              <g class="nn-layer layer-h1">
                {Array.from({length:7}).map((_,i)=><g class="nn-neuron" data-layer="h1" data-neuron={i}><circle cx="292" cy={28+i*38} r="12"></circle><text x="292" y={32+i*38} text-anchor="middle" class="nn-value">{['.81','.12','.64','.35','.77','.48','.22'][i]}</text></g>)}
              </g>
              <g class="nn-layer layer-h2">
                {Array.from({length:6}).map((_,i)=><g class="nn-neuron" data-layer="h2" data-neuron={i}><circle cx="512" cy={47+i*44} r="12"></circle><text x="512" y={51+i*44} text-anchor="middle" class="nn-value">{['.62','.41','.33','.77','.29','.58'][i]}</text></g>)}
              </g>
              <g class="nn-layer layer-output">
                {Array.from({length:4}).map((_,i)=><g class="nn-neuron output-neuron" data-layer="output" data-neuron={i}><circle cx="706" cy={78+i*58} r="14"></circle><text x="706" y={82+i*58} text-anchor="middle" class="nn-value">{['.91','.08','.69','.26'][i]}</text><text x="735" y={82+i*58}>{['ŷ₁','ŷ₂','ŷ₃','ŷ₄'][i]}</text></g>)}
              </g>

              <circle class="signal-dot sig-a" r="5" filter="url(#nnGlow)"><animateMotion dur="1.65s" repeatCount="indefinite" path="M80 42 L292 66 L512 91 L706 78" /></circle>
              <circle class="signal-dot sig-b" r="5" filter="url(#nnGlow)"><animateMotion begin=".35s" dur="1.7s" repeatCount="indefinite" path="M80 130 L292 142 L512 179 L706 194" /></circle>
              <circle class="signal-dot sig-c" r="5" filter="url(#nnGlow)"><animateMotion begin=".72s" dur="1.8s" repeatCount="indefinite" path="M80 262 L292 256 L512 223 L706 252" /></circle>
              <circle class="gradient-dot grad-a" r="4"><animateMotion dur="2.1s" repeatCount="indefinite" path="M706 194 C625 278,548 274,512 223 C430 285,345 282,292 256 C210 292,126 286,80 262" /></circle>
              <circle class="gradient-dot grad-b" r="4"><animateMotion begin=".65s" dur="2.2s" repeatCount="indefinite" path="M706 78 C618 4,548 7,512 47 C430 2,345 5,292 28 C205 5,126 12,80 42" /></circle>
            </svg>

            <div class="activation-probes">
              <div><span>s</span><strong class="formula-text" data-input-values>[.72, .18, .91, .43, .66, .27]</strong></div>
              <i>→</i>
              <div><span>h₁ = σ(W₁s+b₁)</span><strong class="formula-text" data-hidden-values>[.81, .12, .64, .35, ⋯]</strong></div>
              <i>→</i>
              <div><span>h₂ = σ(W₂h₁+b₂)</span><strong class="formula-text" data-hidden2-values>[.62, .41, .33, .77, ⋯]</strong></div>
              <i>→</i>
              <div><span>x̂</span><strong class="formula-text" data-output-values>[.91, .08, .69, .26]</strong></div>
            </div>

            <div class="training-bottom-grid">
              <div class="loss-chart-card">
                <div class="loss-chart-head"><span>training loss</span><strong data-loss-chart-value>0.842</strong></div>
                <svg class="loss-chart" viewBox="0 0 360 110" preserveAspectRatio="none">
                  <path class="loss-gridline" d="M0 20 H360 M0 55 H360 M0 90 H360"/>
                  <polyline data-loss-line points="0,18 0,18" />
                  <circle data-loss-point cx="0" cy="18" r="4"/>
                </svg>
              </div>
              <div class="gradient-card">
                <div><span>{t.labels.forward[lang]}</span><strong class="forward-key">activation →</strong></div>
                <div><span>{t.labels.backward[lang]}</span><strong class="backward-key">← ∇θ𝓛</strong></div>
                <div><span>parameter update</span><strong class="formula-text" data-update-status>Wₗ, bₗ updated</strong></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="demo-scene scene-repair" data-scene="4">
        <div class="scene-copy">
          <span class="scene-number">05</span>
          <p class="eyebrow">FEASIBILITY</p>
          <h3>{t.scenes[4].title[lang]}</h3>
          <p>{t.scenes[4].desc[lang]}</p>
        </div>
        <div class="repair-stage">
          <div class="candidate-vector"><small>{t.labels.candidate[lang]}</small><strong class="formula-text">x̂ = [1.08, −0.04, 0.73, 1.27]</strong></div>
          <div class="repair-checks">
            <div data-repair-row="0" class="repair-check invalid"><span class="formula-text">P ≤ 1.00</span><strong data-repair-val="0">1.08</strong><em data-repair-msg="0">× {t.labels.violated[lang]}</em></div>
            <div data-repair-row="1" class="repair-check invalid"><span class="formula-text">E ≥ 0</span><strong data-repair-val="1">−0.04</strong><em data-repair-msg="1">× {t.labels.violated[lang]}</em></div>
            <div data-repair-row="2" class="repair-check invalid"><span class="formula-text">y ∈ &#123;0,1&#125;</span><strong data-repair-val="2">0.73</strong><em data-repair-msg="2">× {t.labels.violated[lang]}</em></div>
            <div data-repair-row="3" class="repair-check invalid"><span class="formula-text">Στ ≤ T</span><strong data-repair-val="3">1.27T</strong><em data-repair-msg="3">× {t.labels.violated[lang]}</em></div>
          </div>
          <div class="repair-ops">{t.labels.repairOps.map((op,i)=><span data-repair-op={i} style={`--op:${i}`}><b>{String(i+1).padStart(2,'0')}</b>{op[lang]}</span>)}</div>
          <div class="repair-op-note" data-repair-note>{t.labels.repairNotes[0][lang]}</div>
          <div class="repaired-vector" data-repaired-vector><small>{t.labels.feasible[lang]}</small><strong class="formula-text" data-repaired-text>x̃ = [1.00, 0.00, 1, 0.92]</strong><b>✓ {t.labels.satisfied[lang]}</b></div>
        </div>
      </div>

      <div class="demo-scene scene-compare" data-scene="5">
        <div class="scene-copy">
          <span class="scene-number">06</span>
          <p class="eyebrow">COMPARE</p>
          <h3>{t.scenes[5].title[lang]}</h3>
          <p>{t.scenes[5].desc[lang]}</p>
        </div>
        <div class="compare-stage">
          <div class="compare-header"><span>{t.labels.metric[lang]}</span><span>{t.labels.exactCol[lang]}</span><span>{t.labels.aiCol[lang]}</span></div>
          <div class="compare-row"><b>{t.labels.gap[lang]}</b><div><strong>0%</strong><small>{t.labels.optimumQuality[lang]}</small></div><div class="ai-good"><strong>ε%</strong><small>{t.labels.nearOptimal[lang]}</small></div></div>
          <div class="compare-row"><b>{t.labels.feasibleRate[lang]}</b><div><strong>100%</strong><small>hard constraints</small></div><div class="ai-good"><strong>100%</strong><small>after repair</small></div></div>
          <div class="compare-row runtime-row"><b>{t.labels.runtime[lang]}</b><div><span class="runtime-bar exact-runtime"></span><small>{t.labels.slow[lang]}</small></div><div><span class="runtime-bar ai-runtime"></span><small>{t.labels.fast[lang]}</small></div></div>
          <div class="compare-summary"><span>x*</span><i>↔</i><span>x̃</span><strong>near-optimal + feasible + fast</strong></div>
        </div>
      </div>
    </div>
    <div class="demo-caption">
      <span data-caption-index>01</span>
      <div><strong data-caption-title>{t.scenes[0].title[lang]}</strong><p data-caption-desc>{t.scenes[0].desc[lang]}</p></div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-optimization-demo]');
    if (!root) return;
    const scenes = [...root.querySelectorAll('[data-scene]')];
    const buttons = [...root.querySelectorAll('[data-demo-step]')];
    const label = root.querySelector('[data-stage-label]');
    const progress = root.querySelector('[data-demo-progress]');
    const capIndex = root.querySelector('[data-caption-index]');
    const capTitle = root.querySelector('[data-caption-title]');
    const capDesc = root.querySelector('[data-caption-desc]');
    const playBtn = root.querySelector('[data-demo-play]');
    const pauseBtn = root.querySelector('[data-demo-pause]');
    const replayBtn = root.querySelector('[data-demo-replay]');
    const viewport = root.querySelector('.demo-viewport');
    const stageData = JSON.parse(root.dataset.stageData || 'null');
    const fallback = [...buttons].map((button, i) => ({ short: button.querySelector('b')?.textContent || '', title: scenes[i]?.querySelector('h3')?.textContent || '', desc: scenes[i]?.querySelector('.scene-copy>p:last-child')?.textContent || '' }));
    const data = stageData || fallback;
    const durations = [4300, 5600, 4600, 14500, 5600, 5000];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let playing = !reduce;
    let timer = null;
    let localTimers = [];

    const clearLocal = () => { localTimers.forEach(clearTimeout); localTimers = []; };
    const clearMain = () => { if (timer) clearTimeout(timer); timer = null; };

    function syncViewportHeight(){
      const scene = scenes[index];
      if (!viewport || !scene) return;
      // Reset first so a previously taller scene does not keep the next scene artificially tall.
      viewport.style.height = '';
      requestAnimationFrame(() => {
        const viewportRect = viewport.getBoundingClientRect();
        const sceneStyle = getComputedStyle(scene);
        const paddingBottom = parseFloat(sceneStyle.paddingBottom) || 0;
        const minHeight = parseFloat(getComputedStyle(viewport).minHeight) || 620;
        let contentBottom = 0;
        [...scene.children].forEach((child) => {
          const rect = child.getBoundingClientRect();
          contentBottom = Math.max(contentBottom, rect.bottom - viewportRect.top);
        });
        const desired = Math.ceil(contentBottom + paddingBottom + 10);
        viewport.style.height = `${Math.max(minHeight, desired)}px`;
      });
    }

    function animateExpert(){
      const lb = root.querySelector('[data-lb]');
      const ub = root.querySelector('[data-ub]');
      const gap = root.querySelector('[data-gap]');
      const gapBottom = root.querySelector('[data-gap-bottom]');
      const nodeCount = root.querySelector('[data-nodecount]');
      const incumbent = root.querySelector('[data-incumbent]');
      const bestbound = root.querySelector('[data-bestbound]');
      const gapbar = root.querySelector('[data-gapbar]');
      const bbNodes = [...root.querySelectorAll('[data-bb-node]')];
      const logRows = [...root.querySelectorAll('[data-bb-log] p')];
      const mpcCells = [...root.querySelectorAll('[data-mpc-cell]')];

      bbNodes.forEach(n => n.classList.remove('active','visited','incumbent','pruned'));
      logRows.forEach(r => r.classList.remove('active','done'));
      mpcCells.forEach(c => c.classList.remove('active','used'));
      if(lb) lb.textContent='0.620';
      if(ub) ub.textContent='1.310';
      if(gap) gap.textContent='52.7%';
      if(gapBottom) gapBottom.textContent='52.7%';
      if(nodeCount) nodeCount.textContent='01 / 32';
      if(incumbent) incumbent.textContent='1.310';
      if(bestbound) bestbound.textContent='0.620';
      if(gapbar) gapbar.style.width='18%';

      const seq = [
        { t:350,  active:0, visited:[],                 pruned:[],   incumbentNode:null, lb:.620, ub:1.310, gap:'52.7%', node:'01 / 32', log:0, mpc:0 },
        { t:1050, active:1, visited:[0],                pruned:[],   incumbentNode:null, lb:.731, ub:1.310, gap:'44.2%', node:'07 / 32', log:1, mpc:1 },
        { t:1800, active:2, visited:[0,1],              pruned:[4],  incumbentNode:null, lb:.754, ub:1.120, gap:'32.7%', node:'13 / 32', log:1, mpc:2 },
        { t:2550, active:3, visited:[0,1,2,5],          pruned:[4,6],incumbentNode:null, lb:.812, ub:1.020, gap:'20.4%', node:'20 / 32', log:2, mpc:3 },
        { t:3300, active:8, visited:[0,1,2,3,5,7],      pruned:[4,6],incumbentNode:8,    lb:.960, ub:.990,  gap:'3.0%',  node:'27 / 32', log:2, mpc:4 },
        { t:4100, active:10,visited:[0,1,2,3,5,7,8,9],  pruned:[4,6],incumbentNode:8,    lb:.981, ub:.984,  gap:'0.3%',  node:'32 / 32', log:3, mpc:5 }
      ];

      seq.forEach((st) => localTimers.push(setTimeout(() => {
        bbNodes.forEach((n, idx) => {
          n.classList.toggle('visited', st.visited.includes(idx));
          n.classList.toggle('pruned', st.pruned.includes(idx));
          n.classList.toggle('active', idx === st.active);
          n.classList.toggle('incumbent', idx === st.incumbentNode);
        });
        logRows.forEach((r, idx) => {
          r.classList.toggle('active', idx === st.log);
          r.classList.toggle('done', idx < st.log);
        });
        mpcCells.forEach((c, idx) => {
          c.classList.toggle('used', idx < st.mpc);
          c.classList.toggle('active', idx === st.mpc);
        });
        if(lb) lb.textContent=st.lb.toFixed(3);
        if(ub) ub.textContent=st.ub.toFixed(3);
        if(gap) gap.textContent=st.gap;
        if(gapBottom) gapBottom.textContent=st.gap;
        if(nodeCount) nodeCount.textContent=st.node;
        if(incumbent) incumbent.textContent=st.ub.toFixed(3);
        if(bestbound) bestbound.textContent=st.lb.toFixed(3);
        if(gapbar) gapbar.style.width=`${Math.min(98,18 + (1-parseFloat(st.gap)/52.7)*80)}%`;
      }, st.t)));
    }
    function animateDataset(){
      const count = root.querySelector('[data-sample-count]');
      if(count) count.textContent='0';
      let n=0;
      const target=2400;
      const tick=()=>{ n=Math.min(target,n+120); if(count) count.textContent=n.toLocaleString(); if(n<target) localTimers.push(setTimeout(tick,80)); };
      localTimers.push(setTimeout(tick,300));
    }
    function animateTraining(){
      const stage = root.querySelector('.training-stage-v2');
      const phaseLabel = root.querySelector('[data-train-phase-label]');
      const phaseChips = [...root.querySelectorAll('[data-phase-chip]')];
      const loss = root.querySelector('[data-train-loss]');
      const epoch = root.querySelector('[data-train-epoch]');
      const hidden = root.querySelector('[data-hidden-values]');
      const hidden2 = root.querySelector('[data-hidden2-values]');
      const pred = root.querySelector('[data-train-pred]');
      const predOut = root.querySelector('[data-output-values]');
      const target = root.querySelector('[data-train-target]');
      const inputReadout = root.querySelector('[data-input-values]');
      const grad = root.querySelector('[data-train-grad]');
      const lr = root.querySelector('[data-train-lr]');
      const batchCaption = root.querySelector('[data-train-batch-caption]');
      const weightUpdate = root.querySelector('[data-weight-update]');
      const updateStatus = root.querySelector('[data-update-status]');
      const lossLine = root.querySelector('[data-loss-line]');
      const lossPoint = root.querySelector('[data-loss-point]');
      const lossChartValue = root.querySelector('[data-loss-chart-value]');
      const neurons = [...root.querySelectorAll('.nn-neuron')];
      const inputTexts = [...root.querySelectorAll('.layer-input .nn-neuron text:last-child')];
      const h1Texts = [...root.querySelectorAll('.layer-h1 .nn-value')];
      const h2Texts = [...root.querySelectorAll('.layer-h2 .nn-value')];
      const outTexts = [...root.querySelectorAll('.layer-output .nn-value')];

      const presets = [
        {
          input:[.72,.18,.91,.43,.66,.27], target:[1,0,.74,.21], startPred:[.91,.08,.69,.26],
          h1:[.81,.12,.64,.35,.77,.48,.22], h2:[.62,.41,.33,.77,.29,.58],
          losses:[.842,.611,.428,.291,.173,.109,.071,.048], grads:[1.82,1.37,1.02,.74,.53,.34,.21,.16],
          lr:'1e−3', batch:64
        },
        {
          input:[.48,.62,.34,.77,.51,.19], target:[0,1,.58,.36], startPred:[.14,.82,.49,.44],
          h1:[.56,.73,.21,.68,.31,.82,.44], h2:[.41,.67,.52,.28,.75,.39],
          losses:[.731,.548,.376,.244,.151,.092,.061,.039], grads:[1.56,1.22,.91,.66,.47,.31,.19,.13],
          lr:'8e−4', batch:48
        },
        {
          input:[.83,.27,.56,.31,.72,.44], target:[1,1,.42,.18], startPred:[.88,.86,.50,.25],
          h1:[.74,.33,.69,.24,.58,.71,.36], h2:[.70,.36,.61,.45,.32,.66],
          losses:[.668,.489,.337,.219,.138,.086,.054,.035], grads:[1.43,1.08,.82,.59,.42,.28,.18,.12],
          lr:'6e−4', batch:96
        }
      ];

      const setPhase = (phase, labelText) => {
        if(stage) stage.dataset.trainPhase=phase;
        if(phaseLabel) phaseLabel.textContent=labelText;
        phaseChips.forEach(chip => chip.classList.toggle('active', chip.dataset.phaseChip===phase));
        neurons.forEach(n => n.classList.toggle('phase-active', n.dataset.layer===phase));
      };
      const vec = (arr) => '[' + arr.map(v => Number(v).toFixed(2)).join(', ') + ']';
      const updateNeuronColumn = (nodes, values) => nodes.forEach((node,i)=>{ if(node && values[i]!==undefined) node.textContent=Number(values[i]).toFixed(2).replace(/^0/,''); });
      let cycle = 0;

      const runCycle = () => {
        const cfg = presets[cycle % presets.length];
        const cycleOffset = cycle * 60;
        const finalPred = cfg.target.map((t,i)=> Math.max(0, Math.min(1, t + (i%2===0?.01:-.01))));
        const points=[];
        const toPoint=(value,i)=>{
          const x=10+i*(340/(cfg.losses.length-1));
          const y=12+(value/cfg.losses[0])*82;
          return [x,y];
        };

        setPhase('input','FORWARD / INPUT');
        if(target) target.textContent='x* = '+vec(cfg.target);
        if(inputReadout) inputReadout.textContent=vec(cfg.input);
        if(pred) pred.textContent='x̂ = '+vec(cfg.startPred);
        if(predOut) predOut.textContent=vec(cfg.startPred);
        if(loss) loss.textContent=cfg.losses[0].toFixed(3);
        if(lossChartValue) lossChartValue.textContent=cfg.losses[0].toFixed(3);
        if(epoch) epoch.textContent=String(cycleOffset+1).padStart(2,'0')+' / ∞';
        if(grad) grad.textContent=cfg.grads[0].toFixed(2);
        if(lr) lr.textContent=cfg.lr;
        if(batchCaption) batchCaption.textContent=`${cfg.batch} expert state–solution pairs`;
        if(hidden) hidden.textContent=vec(cfg.h1.slice(0,4)) + ' …';
        if(hidden2) hidden2.textContent=vec(cfg.h2.slice(0,4)) + ' …';
        updateNeuronColumn(inputTexts,cfg.input);
        updateNeuronColumn(h1Texts,cfg.h1);
        updateNeuronColumn(h2Texts,cfg.h2);
        updateNeuronColumn(outTexts,cfg.startPred);
        if(weightUpdate) weightUpdate.classList.remove('pulse');
        if(updateStatus) updateStatus.textContent='new mini-batch loaded';
        if(lossLine) lossLine.setAttribute('points','10,94');
        if(lossPoint){ lossPoint.setAttribute('cx','10'); lossPoint.setAttribute('cy','94'); }

        const phaseTimeline = [
          [180,'input','FORWARD / INPUT'],
          [700,'h1','FORWARD / HIDDEN 1'],
          [1220,'h2','FORWARD / HIDDEN 2'],
          [1740,'output','FORWARD / OUTPUT'],
          [2260,'loss','LOSS AGAINST x*'],
          [2780,'backward','BACKPROPAGATION'],
          [3380,'update','PARAMETER UPDATE'],
          [4040,'input','NEXT MINI-BATCH']
        ];
        phaseTimeline.forEach(([delay,phase,text]) => localTimers.push(setTimeout(()=>{
          setPhase(phase,text);
          if(phase==='update'){
            weightUpdate?.classList.add('pulse');
            if(updateStatus) updateStatus.textContent='θ ← θ − η∇θ𝓛';
          } else {
            weightUpdate?.classList.remove('pulse');
            if(updateStatus) updateStatus.textContent=phase==='backward'?'∇θ𝓛 propagating':'Wₗ, bₗ fixed during forward';
          }
        }, delay)));

        cfg.losses.forEach((value,i)=> localTimers.push(setTimeout(()=>{
          const r=i/(cfg.losses.length-1);
          const predVals=cfg.startPred.map((p,j)=> p+(finalPred[j]-p)*r);
          const h1Vals=cfg.h1.map((v,j)=> Math.max(0,Math.min(1,v+(j%2===0?.025:-.018)*r)));
          const h2Vals=cfg.h2.map((v,j)=> Math.max(0,Math.min(1,v+(j%2===0?.018:-.014)*r)));
          if(loss) loss.textContent=value.toFixed(3);
          if(lossChartValue) lossChartValue.textContent=value.toFixed(3);
          if(epoch) epoch.textContent=String(cycleOffset+1+i*8).padStart(2,'0')+' / ∞';
          if(hidden) hidden.textContent=vec(h1Vals.slice(0,4))+' …';
          if(hidden2) hidden2.textContent=vec(h2Vals.slice(0,4))+' …';
          if(pred) pred.textContent='x̂ = '+vec(predVals);
          if(predOut) predOut.textContent=vec(predVals);
          if(grad) grad.textContent=cfg.grads[i].toFixed(2);
          updateNeuronColumn(h1Texts,h1Vals);
          updateNeuronColumn(h2Texts,h2Vals);
          updateNeuronColumn(outTexts,predVals);
          const [x,y]=toPoint(value,i);
          points.push(`${x.toFixed(1)},${y.toFixed(1)}`);
          if(lossLine) lossLine.setAttribute('points',points.join(' '));
          if(lossPoint){ lossPoint.setAttribute('cx',x.toFixed(1)); lossPoint.setAttribute('cy',y.toFixed(1)); }
        }, 260+i*500)));

        localTimers.push(setTimeout(()=>{
          cycle += 1;
          if(scenes[index]?.classList.contains('scene-train') && scenes[index]?.classList.contains('is-active')) runCycle();
        }, 4700));
      };
      runCycle();
    }
    function animateRepair(){
      const rows=[...root.querySelectorAll('[data-repair-row]')];
      const vals=[...root.querySelectorAll('[data-repair-val]')];
      const msgs=[...root.querySelectorAll('[data-repair-msg]')];
      const ops=[...root.querySelectorAll('[data-repair-op]')];
      const note=root.querySelector('[data-repair-note]');
      const repairedText=root.querySelector('[data-repaired-text]');
      const final=root.querySelector('[data-repaired-vector]');
      const fixedVals=['1.00','0.00','1','0.92T'];
      const explain=(root.dataset.repairNotes?JSON.parse(root.dataset.repairNotes):[]);
      const violatedText = (msgs[0]?.textContent || 'violated').replace(/^×\s*/, '');
      rows.forEach(r=>r.classList.remove('fixed','active'));
      ops.forEach(op=>op.classList.remove('active','done'));
      vals.forEach((v,i)=>v.textContent=['1.08','−0.04','0.73','1.27T'][i]);
      msgs.forEach((m)=>m.textContent='× ' + violatedText);
      if(note && explain[0]) note.textContent=explain[0];
      if(repairedText) repairedText.textContent='x̃ = [1.00, 0.00, 1, 0.92]';
      final?.classList.remove('show');
      rows.forEach((row,i)=> localTimers.push(setTimeout(()=>{
        rows.forEach(r=>r.classList.remove('active'));
        ops.forEach((op,j)=>{ op.classList.toggle('active',j===i); if(j<i) op.classList.add('done'); });
        row.classList.add('active','fixed');
        if(vals[i]) vals[i].textContent=fixedVals[i];
        if(msgs[i]) msgs[i].textContent='✓';
        if(note && explain[i]) note.textContent=explain[i];
      },700+i*900)));
      localTimers.push(setTimeout(()=>{ ops.forEach(op=>{ op.classList.remove('active'); op.classList.add('done'); }); final?.classList.add('show'); },4400));
    }
    function runSceneAnimation(i){
      clearLocal();
      if(i===1) animateExpert();
      if(i===2) animateDataset();
      if(i===3) animateTraining();
      if(i===4) animateRepair();
    }

    function show(i, keepPlaying=true){
      index=(i+scenes.length)%scenes.length;
      root.dataset.step=String(index);
      scenes.forEach((scene,j)=>{ scene.classList.remove('is-active'); scene.setAttribute('aria-hidden', j===index?'false':'true'); });
      // force reflow so per-scene CSS animations restart
      void root.offsetWidth;
      scenes[index]?.classList.add('is-active');
      buttons.forEach((button,j)=>button.classList.toggle('active',j===index));
      requestAnimationFrame(syncViewportHeight);
      if(label) label.textContent=data[index]?.short || '';
      if(progress) progress.style.width=`${((index+1)/scenes.length)*100}%`;
      if(capIndex) capIndex.textContent=String(index+1).padStart(2,'0');
      if(capTitle) capTitle.textContent=data[index]?.title || '';
      if(capDesc) capDesc.textContent=data[index]?.desc || '';
      runSceneAnimation(index);
      clearMain();
      if(playing && keepPlaying) timer=setTimeout(()=>show((index+1)%scenes.length,true),durations[index]);
    }

    buttons.forEach((button,i)=>button.addEventListener('click',()=>{ playing=false; show(i,false); }));
    playBtn?.addEventListener('click',()=>{ playing=true; show(index,true); });
    pauseBtn?.addEventListener('click',()=>{ playing=false; clearMain(); });
    replayBtn?.addEventListener('click',()=>{ playing=true; show(0,true); });

    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(syncViewportHeight, 120);
    });

    const observer=new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){ if(!reduce && playing && !timer) show(index,true); }
        else clearMain();
      });
    },{threshold:.22});
    observer.observe(root);
    show(0,false);
    if(!reduce) { playing=true; timer=setTimeout(()=>show(1,true),durations[0]); }
  })();
</script>

