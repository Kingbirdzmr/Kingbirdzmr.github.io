---
import type { Lang, Project } from '../types';
import { ui } from '../i18n/ui';
const { project, lang, index } = Astro.props as { project: Project; lang: Lang; index: number };
---
<article class="project-card" id={project.slug}>
  <div class="project-index">{String(index + 1).padStart(2, '0')}</div>
  <p class="eyebrow">{project.eyebrow[lang]}</p>
  <h3>{project.title[lang]}</h3>
  <p>{project.summary[lang]}</p>
  <div class="tag-row">{project.tags.map((tag) => <span>{tag}</span>)}</div>
  <a class="text-link" href={`/${lang}/research/#${project.slug}`}>{ui.common.explore[lang]} →</a>
</article>
