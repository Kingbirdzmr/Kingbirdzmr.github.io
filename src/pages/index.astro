---
// Static landing page that selects a language in the browser.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex" />
  <title>Mingrui Zheng</title>
  <style>
    html,body{height:100%;margin:0;background:#090c10;color:#eef4ff;font-family:Inter,ui-sans-serif,system-ui,sans-serif}body{display:grid;place-items:center}.box{text-align:center;padding:2rem}.mark{width:64px;height:64px;border:1px solid #69d8ff;border-radius:18px;display:grid;place-items:center;margin:0 auto 1.2rem;font-weight:800}.langs{display:flex;gap:.7rem;justify-content:center;margin-top:1.5rem}.langs a{color:inherit;text-decoration:none;border:1px solid #ffffff22;padding:.7rem 1rem;border-radius:999px}.langs a:hover{border-color:#69d8ff}small{opacity:.55}
  </style>
</head>
<body>
  <div class="box">
    <div class="mark">MZ</div>
    <h1>Mingrui Zheng</h1>
    <small>Academic Homepage</small>
    <div class="langs"><a href="/en/">English</a><a href="/zh/">中文</a><a href="/ja/">日本語</a></div>
  </div>
  <script is:inline>
    document.querySelectorAll('.langs a').forEach((link) => {
      link.addEventListener('click', () => {
        try { sessionStorage.setItem('homepage-language-selected', '1'); } catch {}
      });
    });
  </script>
</body>
</html>
