---
import MainLayout from '../../../layouts/MainLayout.astro';
import PublicationCard from '../../../components/PublicationCard.astro';
import { publications } from '../../../data/publications';
import { profile } from '../../../data/profile';
import { langPaths, isLang } from '../../../utils/routes';
import type { Lang, Publication } from '../../../types';

export function getStaticPaths(){ return langPaths(); }
const param = Astro.params.lang;
if (!isLang(param)) return Astro.redirect('/en/');
const lang: Lang = param;

const heading = { en: 'Publications', zh: '论文', ja: '研究業績' };
const intro = {
  en: 'Last updated: September 2026. Abstracts, BibTeX, and detail pages are not provided for papers under review.',
  zh: '更新时间：2026年9月。在审论文暂不提供摘要、BibTeX 与详情页。',
  ja: '最終更新：2026年9月。査読中の論文については、概要、BibTeX、詳細ページを現時点では掲載していません。'
};
const corresponding = {
  en: 'Corresponding author',
  zh: '通讯作者',
  ja: '責任著者'
};

const categories: { type: Publication['type']; label: Record<Lang, string> }[] = [
  { type: 'journal', label: { en: 'Journal Papers', zh: '期刊论文', ja: '学術雑誌論文' } },
  { type: 'conference', label: { en: 'Conference Papers', zh: '会议论文', ja: '国際会議論文' } },
  { type: 'preprint', label: { en: 'Preprints', zh: '预印本', ja: 'プレプリント' } },
  { type: 'patent', label: { en: 'Patents', zh: '专利', ja: '特許' } }
];
---
<MainLayout {lang} title={`${heading[lang]} | ${profile.name}`} description={intro[lang]}>
  <section class="page-hero section-shell publication-page-hero">
    <p class="eyebrow">PUBLICATIONS</p>
    <h1>{heading[lang]}</h1>
    <p>{intro[lang]}</p>
    <p class="corresponding-note"><sup>*</sup> {corresponding[lang]}</p>
  </section>

  <nav class="section-shell publication-category-nav" aria-label="Publication categories">
    {categories.map((category) => {
      const count = publications.filter((p) => p.type === category.type).length;
      return <a href={`#${category.type}`}><span>{category.label[lang]}</span><b>{count}</b></a>;
    })}
  </nav>

  <section class="section-shell publication-groups">
    {categories.map((category) => {
      const items = publications.filter((p) => p.type === category.type);
      return (
        <section class="publication-category" id={category.type}>
          <div class="publication-category-heading">
            <div>
              <p class="eyebrow">{category.type.toUpperCase()}</p>
              <h2>{category.label[lang]}</h2>
            </div>
            <span class="publication-count">{String(items.length).padStart(2, '0')}</span>
          </div>
          <div class="publication-list">
            {items.map((publication, index) => <PublicationCard {publication} {lang} index={index + 1} />)}
          </div>
        </section>
      );
    })}
  </section>
</MainLayout>
