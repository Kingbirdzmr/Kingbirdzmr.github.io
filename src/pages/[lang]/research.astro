---
import MainLayout from '../../layouts/MainLayout.astro';
import { langPaths, isLang } from '../../utils/routes';
import { profile } from '../../data/profile';
import { projects } from '../../data/projects';
import type { Lang, Localized } from '../../types';

export function getStaticPaths(){ return langPaths(); }
const param = Astro.params.lang;
if(!isLang(param)) return Astro.redirect('/en/');
const lang: Lang = param;
const L = (en:string, zh:string, ja:string): Localized => ({en, zh, ja});

const copy = {
  title: L('Research','研究','研究'),
  intro: L(
    'My research asks how autonomous networked systems can make reliable decisions when communication, computation, energy, and time are all limited.',
    '我的研究关注一个核心问题：当通信、计算、能量和时间都受到约束时，自主网络化系统如何仍然做出可靠、安全且高效的决策。',
    '私の研究は、通信・計算・エネルギー・時間がすべて制約される状況でも、自律ネットワークシステムが信頼性の高い、安全かつ効率的な意思決定を行うにはどうすべきか、という問いを中心にしています。'
  ),
  vision: L('Research Vision','研究愿景','研究ビジョン'),
  visionText: L(
    'I study communication, control, optimization, learning, and security as coupled components of one decision-making system. Rather than optimizing each layer in isolation, my goal is to build methods that understand which information matters to control, which computations are worth performing, and how limited resources should be allocated under uncertainty and attacks.',
    '我将通信、控制、优化、学习与安全视为同一个决策系统中的耦合组成部分，而不是彼此独立的模块。我的目标不是分别优化每一层，而是让系统理解哪些信息真正影响控制、哪些计算值得执行，以及在不确定性和攻击存在时有限资源应如何分配。',
    '通信、制御、最適化、学習、セキュリティを個別の層ではなく、一つの意思決定システムを構成する相互依存要素として扱います。各層を独立に最適化するのではなく、制御に本当に重要な情報は何か、どの計算を実行する価値があるか、不確実性や攻撃下で限られた資源をどう配分すべきかを理解する手法の構築を目指します。'
  ),
  questions: L('Core Research Questions','核心研究问题','中核研究課題'),
  questionsIntro: L(
    'Five questions connect most of my current work and define the direction of my doctoral research.',
    '以下五个问题贯穿我目前的大部分工作，也构成博士阶段研究的主要主线。',
    '以下の5つの問いは、現在の研究の多くをつなぎ、博士課程における研究の方向性を形作っています。'
  ),
  pipeline: L('Optimization-to-Learning Pipeline','优化到学习求解的流程','最適化から学習解法へのパイプライン'),
  pipelineIntro: L(
    'A recurring pattern in my research is to formulate an optimization problem, solve it with exact algorithms to generate expert solutions, distill the structure into a neural model, and then repair the prediction so that it remains feasible and close to the optimum.',
    '我在很多工作中都遵循这样一个流程：先建立优化问题，再用精确算法生成专家解；随后把专家决策蒸馏为神经网络模型，并对预测解进行规范化与修复，使其既满足约束，又尽量接近最优解。',
    '私の研究では、まず最適化問題を定式化し、厳密アルゴリズムで専門家解を生成し、その構造をニューラルモデルへ蒸留し、最後に予測解を正規化・修復して実行可能かつ最適解に近い解へ整える、という流れを繰り返し用います。'
  ),
  themes: L('Research Themes','研究主题','研究テーマ'),
  themesIntro: L(
    'The questions above are developed through eight connected research themes, organized into three broader clusters.',
    '上述问题通过八个相互关联的研究主题展开，并归纳为三个更高层次的研究集群。',
    '上記の問いを、相互に関連する8つの研究テーマとして展開し、3つの大きなクラスターに整理しています。'
  ),
  methods: L('Methodological Toolbox','方法工具箱','方法論ツールボックス'),
  methodsIntro: L(
    'I combine model-based optimization and control with learning-based acceleration and networked-system modeling.',
    '我的方法体系将模型驱动的优化与控制、学习驱动的加速方法以及网络化系统建模结合起来。',
    'モデルベースの最適化・制御、学習による高速化、ネットワーク化システムのモデリングを組み合わせています。'
  )
};

const questions = [
  L(
    'How can communication decisions be made control-aware, so that limited wireless resources are allocated according to their actual impact on closed-loop performance rather than conventional communication metrics alone?',
    '在通信资源受限、网络时延和不确定性并存的情况下，如何让通信决策真正服务于闭环控制性能，而不是单纯优化吞吐量或频谱效率？',
    '限られた無線資源を、従来の通信指標だけでなく閉ループ制御性能への実際の影響に基づいて割り当てるには、通信と制御をどのように協調設計すべきか？'
  ),
  L(
    'How can multiple UAVs jointly sense, communicate, plan, and control under bandwidth, energy, sensing, and computing constraints while maintaining safety and scalability?',
    '在带宽、能量、感知范围和计算资源均受限的环境中，多无人机如何协同感知、通信、规划与控制，并实现安全且可扩展的自主决策？',
    '帯域、エネルギー、センシング範囲、計算資源が制約される環境において、複数UAVが安全性とスケーラビリティを保ちながら、センシング・通信・計画・制御をどのように協調できるか？'
  ),
  L(
    'How can learning models such as graph neural networks and large language models accelerate complex optimization while preserving feasibility, safety, and constraint satisfaction?',
    '如何利用图神经网络、大语言模型等学习方法加速复杂组合优化，同时保留传统优化方法在可行性、安全性和约束满足方面的保证？',
    'グラフニューラルネットワークや大規模言語モデルなどの学習手法を用いて複雑な最適化を高速化しつつ、実行可能性、安全性、制約充足をどのように保証できるか？'
  ),
  L(
    'How can communication, control, and resource scheduling be jointly designed so that autonomous networked systems remain safe and operational under cyber attacks, eavesdropping, and model uncertainty?',
    '当网络化自主系统遭受DDoS、恶意软件、窃听或模型不确定性影响时，如何联合设计通信、控制与资源调度，使系统在攻击和扰动下仍保持安全与服务连续性？',
    'DDoS、マルウェア、盗聴、モデル不確実性などが存在する状況でも自律ネットワークシステムの安全性と継続運用を維持するために、通信・制御・資源スケジューリングをどのように統合設計すべきか？'
  ),
  L(
    'When communication, computation, energy, and time are all scarce, how should an intelligent system determine what information to transmit, what tasks to compute, and which decisions require immediate action?',
    '当通信、计算、能量和时间都成为稀缺资源时，智能系统应该如何判断“什么信息值得传、什么任务值得算、什么决策需要立即执行”？',
    '通信・計算・エネルギー・時間がすべて限られる状況で、知的システムは「何を送るべきか、何を計算すべきか、どの判断を即時に実行すべきか」をどのように決定すべきか？'
  )
];


const pipelineData = {
  problemTitle: L('Optimization problem', '最优化问题', '最適化問題'),
  problemBody: L(
    'Define state, objective, and constraints: allocate communication, control, motion, and computation variables to minimize cost or maximize utility under energy, latency, capacity, and safety constraints.',
    '定义状态、目标与约束：联合决定通信、控制、运动与计算变量，在能量、时延、容量与安全约束下最小化代价或最大化效用。',
    '状態・目的関数・制約を定義し、エネルギー・遅延・容量・安全制約の下で、通信・制御・移動・計算の変数を同時に決定します。'
  ),
  exactTitle: L('Exact / expert solver', '精确 / 专家求解器', '厳密 / 専門家ソルバ'),
  exactBody: L(
    'Use MPC, MILP/MINLP, dynamic programming, or decomposition algorithms to compute optimal or near-optimal expert decisions x*.',
    '使用 MPC、MILP/MINLP、动态规划或分解算法，求得最优或近最优的专家决策 x*。',
    'MPC、MILP/MINLP、動的計画法、分解法などを用いて、最適または準最適な専門家解 x* を求めます。'
  ),
  datasetTitle: L('Expert dataset', '专家数据集', '専門家データセット'),
  datasetBody: L(
    'Collect context–solution pairs D = {(s, x*)}: system states, channel conditions, task graphs, topology features, and their corresponding expert solutions.',
    '构建情境—解对 D = {(s, x*)}：包括系统状态、信道条件、任务图、拓扑特征，以及对应的专家最优解。',
    '文脈–解のペア D = {(s, x*)} を構築します。システム状態、チャネル条件、タスクグラフ、トポロジ特徴と、それに対応する専門家解を含みます。'
  ),
  trainTitle: L('Training objective', '训练目标', '学習目的'),
  trainBody: L(
    'Train the model by minimizing imitation loss + regularization + constraint-aware penalties, so that the network learns the structure of the expert solution map.',
    '通过最小化模仿损失 + 正则项 + 约束感知惩罚项来训练模型，使网络学习专家解映射的结构。',
    '模倣損失 + 正則化 + 制約認識型ペナルティを最小化し、専門家解写像の構造をネットワークに学習させます。'
  ),
  predictTitle: L('Neural prediction', '神经网络预测', 'ニューラル予測'),
  predictBody: L(
    'Given a new state s, the trained network outputs a fast candidate solution x-hat. This stage replaces heavy optimization at deployment time.',
    '对于新的状态 s，训练后的网络快速输出候选解 x̂。该阶段在部署时替代了高开销优化。',
    '新しい状態 s に対して、学習済みネットワークは高速な候補解 x̂ を出力します。実行時には重い最適化の代替となります。'
  ),
  repairTitle: L('Normalization / feasibility repair', '规范化 / 可行性修复', '正規化 / 実行可能化修復'),
  repairBody: L(
    'Project, clip, round, rebalance, or run a lightweight repair layer so that the candidate satisfies hard constraints and can be safely executed.',
    '通过投影、截断、取整、再平衡或轻量修复层，使候选解满足硬约束并可安全执行。',
    '射影、クリッピング、丸め、再配分、軽量な修復層を用いて、候補解をハード制約に適合させ安全に実行可能にします。'
  ),
  compareTitle: L('Comparison with optimal solution', '与最优解对比', '最適解との比較'),
  compareBody: L(
    'Evaluate optimality gap, feasibility, runtime, and robustness. The target is a solver that is much faster than exact optimization while remaining near-optimal.',
    '从最优性差距、可行性、运行时间与鲁棒性四个方面比较。目标是显著快于精确优化，同时保持近最优性能。',
    '最適性ギャップ、実行可能性、計算時間、ロバスト性を比較します。厳密最適化より大幅に高速でありながら、最適解に近い性能を保つことが目標です。'
  ),
  nnLabels: {
    input: L('Input features', '输入特征', '入力特徴'),
    hidden1: L('Hidden layer 1', '隐藏层 1', '中間層 1'),
    hidden2: L('Hidden layer 2', '隐藏层 2', '中間層 2'),
    output: L('Output neurons', '输出神经元', '出力ニューロン'),
    vector: L('Solution vector', '解向量', '解ベクトル')
  },
  compareBullets: [
    L('Optimality gap: f(x-tilde) - f(x*)', '最优性差距：f(x̃) - f(x*)', '最適性ギャップ：f(x̃) - f(x*)'),
    L('Feasibility: all hard constraints satisfied', '可行性：满足全部硬约束', '実行可能性：すべてのハード制約を満たす'),
    L('Runtime: milliseconds vs. seconds/minutes', '速度：毫秒级 vs. 秒/分钟级', '計算時間：ミリ秒級 vs. 秒 / 分級'),
    L('Generalization under unseen system states', '对未见状态的泛化能力', '未知状態に対する汎化性能')
  ]
};

const clusters = [
  {
    number: 'A',
    title: L('Autonomous Networked Systems','自主网络化系统','自律ネットワークシステム'),
    description: L('Communication, control, mobility, and resilience for connected autonomous systems.','面向互联自主系统的通信、控制、移动与韧性设计。','接続型自律システムの通信・制御・移動・レジリエンス設計。'),
    slugs: ['communication-control-codesign','multi-uav-autonomy','cyber-physical-security']
  },
  {
    number: 'B',
    title: L('Learning & Optimization','学习与优化','学習・最適化'),
    description: L('Learning methods that accelerate or structure difficult optimization and control decisions.','利用学习方法加速或结构化复杂的优化与控制决策。','学習手法を用いて複雑な最適化・制御意思決定を高速化・構造化します。'),
    slugs: ['learning-optimization','llm-guided-control']
  },
  {
    number: 'C',
    title: L('Networked Intelligence','网络化智能','ネットワーク知能'),
    description: L('Edge intelligence, secure wireless systems, and lightweight sensing under resource constraints.','面向资源受限环境的边缘智能、安全无线系统与轻量感知。','資源制約下のエッジ知能、セキュア無線システム、軽量センシング。'),
    slugs: ['uav-edge-vnf','secure-energy-aware-iot','intelligent-sensing']
  }
];

const toolbox = [
  {
    title: L('Optimization & Control','优化与控制','最適化・制御'),
    items: ['Model Predictive Control (MPC)','Distributed MPC','MILP / MINLP','Risk-Aware & Robust Optimization','Sample Average Approximation']
  },
  {
    title: L('Learning & AI','学习与人工智能','学習・AI'),
    items: ['Graph Neural Networks','Imitation Learning','LLM-Guided Optimization','DNN Split Inference','Mixture of Experts']
  },
  {
    title: L('Networked Systems','网络化系统','ネットワークシステム'),
    items: ['Multi-UAV Systems','Edge Computing & VNF','Physical-Layer Security','Energy Harvesting','3D Gaussian Mapping']
  }
];
---
<MainLayout {lang} title={`${copy.title[lang]} | ${profile.name}`} description={copy.intro[lang]}>
  <section class="page-hero section-shell research-hero">
    <p class="eyebrow">RESEARCH AGENDA</p>
    <h1>{copy.title[lang]}</h1>
    <p>{copy.intro[lang]}</p>
  </section>

  <section class="section-shell research-vision" data-reveal>
    <div class="research-section-heading">
      <p class="eyebrow">01 / VISION</p>
      <h2>{copy.vision[lang]}</h2>
    </div>
    <p class="research-vision-copy">{copy.visionText[lang]}</p>
  </section>

  <section class="section-shell research-core-section" data-reveal>
    <div class="research-section-split">
      <div><p class="eyebrow">02 / QUESTIONS</p><h2>{copy.questions[lang]}</h2></div>
      <p>{copy.questionsIntro[lang]}</p>
    </div>
    <ol class="research-question-grid">
      {questions.map((q,i)=><li><span class="research-question-index">Q{String(i+1).padStart(2,'0')}</span><p>{q[lang]}</p></li>)}
    </ol>
  </section>

  <section class="section-shell ai-pipeline-section" data-reveal>
    <div class="research-section-split">
      <div><p class="eyebrow">03 / PIPELINE</p><h2>{copy.pipeline[lang]}</h2></div>
      <p>{copy.pipelineIntro[lang]}</p>
    </div>

    <div class="pipeline-flow-grid">
      <article class="pipeline-card problem-card">
        <span class="pipeline-step">01</span>
        <p class="eyebrow">FORMULATE</p>
        <h3>{pipelineData.problemTitle[lang]}</h3>
        <p>{pipelineData.problemBody[lang]}</p>
        <div class="problem-formula">
          <span>min / max &nbsp; f(x; s)</span>
          <span>s.t. &nbsp; g(x; s) ≤ 0</span>
          <span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; h(x; s) = 0</span>
        </div>
      </article>

      <div class="pipeline-arrow arrow-right arrow-a"><span></span></div>

      <article class="pipeline-card exact-card">
        <span class="pipeline-step">02A</span>
        <p class="eyebrow">EXPERT SOLVER</p>
        <h3>{pipelineData.exactTitle[lang]}</h3>
        <p>{pipelineData.exactBody[lang]}</p>
        <div class="mini-tags"><span>MPC</span><span>MILP</span><span>MINLP</span><span>DP</span></div>
      </article>

      <div class="pipeline-arrow arrow-right arrow-b"><span></span></div>

      <article class="pipeline-card compare-card">
        <span class="pipeline-step">05</span>
        <p class="eyebrow">EVALUATE</p>
        <h3>{pipelineData.compareTitle[lang]}</h3>
        <p>{pipelineData.compareBody[lang]}</p>
        <ul class="compare-bullets">
          {pipelineData.compareBullets.map(item => <li>{item[lang]}</li>)}
        </ul>
      </article>

      <div class="pipeline-arrow arrow-down arrow-c"><span></span></div>
      <div class="pipeline-arrow arrow-down arrow-d"><span></span></div>
      <div class="pipeline-arrow arrow-left arrow-e"><span></span></div>

      <article class="pipeline-card dataset-card">
        <span class="pipeline-step">02B</span>
        <p class="eyebrow">DATASET</p>
        <h3>{pipelineData.datasetTitle[lang]}</h3>
        <p>{pipelineData.datasetBody[lang]}</p>
        <div class="dataset-strip">
          <div><strong>s₁</strong><span>x*₁</span></div>
          <div><strong>s₂</strong><span>x*₂</span></div>
          <div><strong>s₃</strong><span>x*₃</span></div>
          <div><strong>⋯</strong><span>⋯</span></div>
        </div>
      </article>

      <div class="pipeline-arrow arrow-right arrow-f"><span></span></div>

      <article class="pipeline-card nn-card">
        <span class="pipeline-step">03</span>
        <p class="eyebrow">LEARN</p>
        <h3>{pipelineData.predictTitle[lang]}</h3>
        <p>{pipelineData.trainBody[lang]}</p>
        <div class="nn-legend">
          <span>{pipelineData.nnLabels.input[lang]}</span>
          <span>{pipelineData.nnLabels.hidden1[lang]}</span>
          <span>{pipelineData.nnLabels.hidden2[lang]}</span>
          <span>{pipelineData.nnLabels.output[lang]}</span>
        </div>
        <div class="nn-network" aria-label="Neural network flow">
          <div class="nn-column">{Array.from({length:4}).map(() => <span class="nn-node"></span>)}</div>
          <div class="nn-column">{Array.from({length:5}).map(() => <span class="nn-node"></span>)}</div>
          <div class="nn-column">{Array.from({length:5}).map(() => <span class="nn-node"></span>)}</div>
          <div class="nn-column">{Array.from({length:3}).map(() => <span class="nn-node out"></span>)}</div>
          <svg viewBox="0 0 360 150" preserveAspectRatio="none" class="nn-links">
            {Array.from({length:4}).map((_,i) => Array.from({length:5}).map((__,j) => <line x1={30} y1={25+i*30} x2={125} y2={15+j*27}></line>))}
            {Array.from({length:5}).map((_,i) => Array.from({length:5}).map((__,j) => <line x1={140} y1={15+i*27} x2={235} y2={15+j*27}></line>))}
            {Array.from({length:5}).map((_,i) => Array.from({length:3}).map((__,j) => <line x1={250} y1={15+i*27} x2={330} y2={42+j*30}></line>))}
          </svg>
        </div>
        <div class="nn-equation">x̂ = NN(s; θ), &nbsp; θ ← arg min <em>L</em><sub>imit.</sub> + λ<em>L</em><sub>reg.</sub> + μ<em>L</em><sub>cons.</sub></div>
      </article>

      <div class="pipeline-arrow arrow-right arrow-g"><span></span></div>

      <article class="pipeline-card repair-card">
        <span class="pipeline-step">04</span>
        <p class="eyebrow">REPAIR</p>
        <h3>{pipelineData.repairTitle[lang]}</h3>
        <p>{pipelineData.repairBody[lang]}</p>
        <div class="repair-stream">
          <span>x̂</span><span>projection</span><span>rounding</span><span>repair LP</span><span>x̃</span>
        </div>
        <div class="repair-note">{pipelineData.predictBody[lang]}</div>
      </article>
    </div>
  </section>

  <section class="section-shell research-themes-section" data-reveal>
    <div class="research-section-split">
      <div><p class="eyebrow">04 / THEMES</p><h2>{copy.themes[lang]}</h2></div>
      <p>{copy.themesIntro[lang]}</p>
    </div>
    <div class="research-cluster-list">
      {clusters.map(cluster => (
        <section class="research-cluster">
          <header class="research-cluster-head">
            <span>{cluster.number}</span>
            <div><h3>{cluster.title[lang]}</h3><p>{cluster.description[lang]}</p></div>
          </header>
          <div class="research-theme-grid">
            {cluster.slugs.map(slug => {
              const theme = projects.find(p => p.slug === slug)!;
              return <article class="research-theme-card" id={theme.slug}>
                <p class="eyebrow">{theme.eyebrow[lang]}</p>
                <h4>{theme.title[lang]}</h4>
                <p>{theme.summary[lang]}</p>
                <div class="tag-row">{theme.tags.map(tag => <span>{tag}</span>)}</div>
              </article>;
            })}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section-shell research-methods-section" data-reveal>
    <div class="research-section-split">
      <div><p class="eyebrow">05 / METHODS</p><h2>{copy.methods[lang]}</h2></div>
      <p>{copy.methodsIntro[lang]}</p>
    </div>
    <div class="method-toolbox-grid">
      {toolbox.map((group,index)=><article class="method-toolbox-card"><span>0{index+1}</span><h3>{group.title[lang]}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></article>)}
    </div>
  </section>
</MainLayout>
