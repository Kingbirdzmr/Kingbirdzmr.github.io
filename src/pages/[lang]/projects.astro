---
import MainLayout from '../../layouts/MainLayout.astro';
import { selectedProjects } from '../../data/projects';
import { publications } from '../../data/publications';
import { profile } from '../../data/profile';
import { langPaths,isLang } from '../../utils/routes';
import type { Lang, Localized, Publication } from '../../types';

export function getStaticPaths(){return langPaths();}
const param=Astro.params.lang;
if(!isLang(param))return Astro.redirect('/en/');
const lang:Lang=param;

const L = (en:string, zh:string, ja:string): Localized => ({en,zh,ja});
const copy = {
  heading: L('Projects & Research Portfolio','项目与研究成果','プロジェクト・研究ポートフォリオ'),
  intro: L(
    'A project-based view of what I have built, published, and developed with collaborators. Research directions and scientific questions are presented separately on the Research page.',
    '从具体项目、科研产出、学术影响与合作网络展示我已经开展和完成的工作。研究方向与核心科学问题则集中在“研究”页面。',
    '具体的なプロジェクト、研究成果、学術的可視性、共同研究ネットワークを通じて、これまでに取り組んできた仕事をまとめています。研究テーマと中核研究課題は「研究」ページに分けて掲載しています。'
  ),
  overview: L('Portfolio at a Glance','成果概览','ポートフォリオ概要'),
  overviewIntro: L('A compact snapshot of current research output and collaboration activity.','当前科研产出与合作情况的简要概览。','現在の研究成果と共同研究活動を簡潔にまとめたスナップショットです。'),
  peerReviewed: L('Peer-reviewed papers','已发表/已录用论文','査読付き論文'),
  reads: L('ResearchGate reads','ResearchGate 阅读量','ResearchGate 閲覧数'),
  citations: L('ResearchGate citations','ResearchGate 引用量','ResearchGate 被引用数'),
  collaborators: L('Collaborators','合作者','共同研究者'),
  selected: L('Selected Projects','代表项目','主要プロジェクト'),
  selectedIntro: L('Representative systems and methods that connect the research agenda to concrete technical outcomes.','将研究议题落实到具体系统、算法和技术成果中的代表性项目。','研究課題を具体的なシステム、アルゴリズム、技術成果へつなぐ代表的なプロジェクトです。'),
  output: L('Research Output','科研产出','研究成果'),
  outputIntro: L('Under-review manuscripts are shown separately and are not counted as publication output.','在审论文单独列出，不计入发文量。','査読中の原稿は別枠で表示し、研究成果数には含めていません。'),
  category: L('Category','类别','区分'),
  count: L('Count','数量','件数'),
  note: L('Status / note','状态 / 说明','状態 / 備考'),
  journals: L('Journal papers','期刊论文','学術雑誌論文'),
  conferences: L('Conference papers','会议论文','国際会議論文'),
  preprints: L('Preprints','预印本','プレプリント'),
  patents: L('Patents','专利','特許'),
  underReview: L('Under review','在审论文','査読中'),
  journalNote: L('Published, Early Access, or accepted','已发表、在线发表或已录用','掲載済み、オンライン公開、または採択済み'),
  confNote: L('Accepted; proceedings may be forthcoming','已录用；部分尚未见刊','採択済み。一部はプロシーディングス未刊行'),
  preprintNote: L('Not included in peer-reviewed paper count','不计入同行评审论文发文量','査読付き論文数には含めない'),
  patentNote: L('Under examination','审查中','審査中'),
  reviewNote: L('Excluded from publication count','不计入发文量','研究成果数から除外'),
  impact: L('Visibility & Impact','阅读与引用','可視性・インパクト'),
  metric: L('Metric','指标','指標'),
  value: L('Value','数值','値'),
  source: L('Source','来源','出典'),
  rgReads: L('Publication reads','论文阅读量','論文閲覧数'),
  rgCitations: L('Citations','引用量','被引用数'),
  sourceNote: L('Public ResearchGate profile; values can change as the profile is updated.','公开 ResearchGate 主页；数值会随平台更新而变化。','公開ResearchGateプロフィール。数値はプロフィール更新に伴って変動します。'),
  checked: L('Checked Sep. 2026','2026年9月更新','2026年9月確認'),
  network: L('Collaboration Network','合作网络','共同研究ネットワーク'),
  networkIntro: L('Co-authors appearing in the current publication, preprint, patent, and under-review manuscript list.','当前期刊、会议、预印本、专利及在审论文列表中出现的合作者。','現在の学術雑誌、国際会議、プレプリント、特許、査読中原稿に含まれる共同研究者です。'),
  works: L('works','项合作','件'),
  collaboratedWorks: L('Collaborated papers','合作论文','共同研究論文'),
  hoverHint: L('Hover or click a collaborator to view the related papers.','将鼠标移到合作者上或点击，即可查看具体合作论文。','共同研究者にカーソルを合わせるかクリックすると、関連論文を確認できます。'),
  openDetails: L('Show collaborated papers','查看合作论文','共同研究論文を表示'),
  closeDetails: L('Close','关闭','閉じる'),
  publication: L('Publication','对应论文','関連論文'),
  viewPublication: L('View publication','查看论文','論文を見る'),
  viewList: L('View in publication list','在论文列表中查看','研究業績一覧で見る')
};

const peerReviewed = publications.filter(p => (p.type === 'journal' || p.type === 'conference') && p.statusKind !== 'under-review');
const journalCount = peerReviewed.filter(p => p.type === 'journal').length;
const conferenceCount = peerReviewed.filter(p => p.type === 'conference').length;
const preprintCount = publications.filter(p => p.type === 'preprint').length;
const patentCount = publications.filter(p => p.type === 'patent').length;
const underReviewCount = publications.filter(p => p.statusKind === 'under-review').length;

const collaboratorWorks = new Map<string, Publication[]>();
for (const publication of publications) {
  for (const author of new Set(publication.authors)) {
    if (author === 'Mingrui Zheng') continue;
    const works = collaboratorWorks.get(author) ?? [];
    works.push(publication);
    collaboratorWorks.set(author, works);
  }
}
const collaborators = [...collaboratorWorks.entries()]
  .map(([name, works]) => ({ name, count: works.length, works }))
  .sort((a,b) => b.count - a.count || a.name.localeCompare(b.name));
const initials = (name:string) => {
  const parts = name.replace(/\./g,'').trim().split(/\s+/).filter(Boolean);
  if (parts.length === 1) return parts[0].slice(0,2).toUpperCase();
  return `${parts[0][0] ?? ''}${parts[parts.length-1][0] ?? ''}`.toUpperCase();
};

const impact = { reads: 27, citations: 5, sourceUrl: 'https://www.researchgate.net/profile/Mingrui-Zheng-2' };
const publicationMap = new Map(publications.map(p => [p.slug, p] as const));
const publicationHref = (p:Publication) => p.detailPage === false
  ? `/${lang}/publications/#${p.slug}`
  : `/${lang}/publications/${p.slug}/`;
---
<MainLayout {lang} title={`${copy.heading[lang]} | ${profile.name}`} description={copy.intro[lang]}>
  <section class="page-hero section-shell project-portfolio-hero">
    <p class="eyebrow">PROJECTS / PORTFOLIO</p>
    <h1>{copy.heading[lang]}</h1>
    <p>{copy.intro[lang]}</p>
  </section>

  <section class="section-shell portfolio-section" data-reveal>
    <div class="portfolio-section-heading">
      <div><p class="eyebrow">01 / OVERVIEW</p><h2>{copy.overview[lang]}</h2></div>
      <p>{copy.overviewIntro[lang]}</p>
    </div>
    <div class="portfolio-metric-grid">
      <article class="portfolio-metric-card"><strong>{peerReviewed.length}</strong><span>{copy.peerReviewed[lang]}</span></article>
      <article class="portfolio-metric-card"><strong>{impact.reads}+</strong><span>{copy.reads[lang]}</span></article>
      <article class="portfolio-metric-card"><strong>{impact.citations}+</strong><span>{copy.citations[lang]}</span></article>
      <article class="portfolio-metric-card"><strong>{collaborators.length}</strong><span>{copy.collaborators[lang]}</span></article>
    </div>
  </section>

  <section class="section-shell portfolio-section selected-projects-section" data-reveal>
    <div class="portfolio-section-heading">
      <div><p class="eyebrow">02 / PROJECTS</p><h2>{copy.selected[lang]}</h2></div>
      <p>{copy.selectedIntro[lang]}</p>
    </div>
    <div class="selected-project-grid">
      {selectedProjects.map((project,index) => {
        const publication = publicationMap.get(project.publicationSlug)!;
        return <article class="selected-project-card" id={project.slug}>
          <div class="selected-project-card-head"><span class="selected-project-index">{String(index+1).padStart(2,'0')}</span><span class:list={['publication-status', `status-${publication.statusKind ?? 'default'}`]}>{publication.status?.[lang] ?? publication.year}</span></div>
          <h3>{project.title[lang]}</h3>
          <p>{project.summary[lang]}</p>
          <div class="tag-row">{project.tags.map(tag => <span>{tag}</span>)}</div>
          <div class="project-publication-line"><span>{copy.publication[lang]}</span><strong>{publication.venue}</strong></div>
          <a class="text-link" href={publicationHref(publication)}>{publication.detailPage === false ? copy.viewList[lang] : copy.viewPublication[lang]} →</a>
        </article>;
      })}
    </div>
  </section>

  <section class="section-shell portfolio-two-column" data-reveal>
    <article class="portfolio-panel">
      <div class="portfolio-panel-head"><p class="eyebrow">03 / OUTPUT</p><h2>{copy.output[lang]}</h2><p>{copy.outputIntro[lang]}</p></div>
      <div class="portfolio-table-wrap">
        <table class="portfolio-table">
          <thead><tr><th>{copy.category[lang]}</th><th>{copy.count[lang]}</th><th>{copy.note[lang]}</th></tr></thead>
          <tbody>
            <tr><td>{copy.journals[lang]}</td><td>{journalCount}</td><td>{copy.journalNote[lang]}</td></tr>
            <tr><td>{copy.conferences[lang]}</td><td>{conferenceCount}</td><td>{copy.confNote[lang]}</td></tr>
            <tr><td>{copy.preprints[lang]}</td><td>{preprintCount}</td><td>{copy.preprintNote[lang]}</td></tr>
            <tr><td>{copy.patents[lang]}</td><td>{patentCount}</td><td>{copy.patentNote[lang]}</td></tr>
            <tr class="portfolio-table-muted"><td>{copy.underReview[lang]}</td><td>{underReviewCount}</td><td>{copy.reviewNote[lang]}</td></tr>
          </tbody>
        </table>
      </div>
    </article>

    <article class="portfolio-panel">
      <div class="portfolio-panel-head"><p class="eyebrow">04 / IMPACT</p><h2>{copy.impact[lang]}</h2></div>
      <div class="portfolio-table-wrap">
        <table class="portfolio-table impact-table">
          <thead><tr><th>{copy.metric[lang]}</th><th>{copy.value[lang]}</th><th>{copy.source[lang]}</th></tr></thead>
          <tbody>
            <tr><td>{copy.rgReads[lang]}</td><td class="impact-value">{impact.reads}+</td><td><a href={impact.sourceUrl} target="_blank" rel="noreferrer">ResearchGate ↗</a></td></tr>
            <tr><td>{copy.rgCitations[lang]}</td><td class="impact-value">{impact.citations}+</td><td><a href={impact.sourceUrl} target="_blank" rel="noreferrer">ResearchGate ↗</a></td></tr>
          </tbody>
        </table>
      </div>
      <p class="portfolio-source-note">{copy.checked[lang]} · {copy.sourceNote[lang]}</p>
    </article>
  </section>

  <section class="section-shell portfolio-section collaboration-section" data-reveal>
    <div class="portfolio-section-heading">
      <div><p class="eyebrow">05 / NETWORK</p><h2>{copy.network[lang]}</h2></div>
      <p>{copy.networkIntro[lang]}</p>
    </div>
    <p class="collaboration-hint">{copy.hoverHint[lang]}</p>
    <div class="collaborator-grid" data-collaborator-grid>
      {collaborators.map((person, index) => (
        <button
          type="button"
          class="collaborator-card"
          data-collaborator-card
          data-collaborator-index={index}
          aria-label={`${copy.openDetails[lang]}: ${person.name}`}
          aria-expanded="false"
        >
          <div class="collaborator-avatar" aria-hidden="true">{initials(person.name)}</div>
          <div class="collaborator-copy"><strong>{person.name}</strong><span>{person.count} {copy.works[lang]}</span></div>
          <span class="collaborator-card-arrow" aria-hidden="true">↗</span>
          <template data-collaborator-template>
            <div class="collaborator-popover-head">
              <div class="collaborator-avatar collaborator-avatar-large" aria-hidden="true">{initials(person.name)}</div>
              <div>
                <strong>{person.name}</strong>
                <span>{person.count} {copy.works[lang]}</span>
              </div>
            </div>
            <div class="collaborator-popover-label">{copy.collaboratedWorks[lang]}</div>
            <div class="collaborator-work-list">
              {person.works.map((publication) => (
                <a class="collaborator-work-item" href={publicationHref(publication)}>
                  <span class:list={['collaborator-work-status', `status-${publication.statusKind ?? 'default'}`]}>{publication.status?.[lang] ?? publication.year}</span>
                  <strong>{publication.title[lang]}</strong>
                  {lang !== 'en' && <small class="collaborator-work-original">{publication.title.en}</small>}
                  <small>{publication.venue} · {publication.year}</small>
                </a>
              ))}
            </div>
          </template>
        </button>
      ))}
    </div>

    <div class="collaborator-popover" data-collaborator-popover aria-hidden="true" role="dialog" aria-live="polite">
      <button type="button" class="collaborator-popover-close" data-collaborator-close aria-label={copy.closeDetails[lang]}>×</button>
      <div data-collaborator-popover-content></div>
    </div>
    <div class="collaborator-popover-backdrop" data-collaborator-backdrop aria-hidden="true"></div>
  </section>

  <script is:inline>
    (() => {
      const grid = document.querySelector('[data-collaborator-grid]');
      const popover = document.querySelector('[data-collaborator-popover]');
      const content = document.querySelector('[data-collaborator-popover-content]');
      const closeButton = document.querySelector('[data-collaborator-close]');
      const backdrop = document.querySelector('[data-collaborator-backdrop]');
      if (!grid || !popover || !content) return;

      const cards = [...grid.querySelectorAll('[data-collaborator-card]')];
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      let pinned = false;
      let activeCard = null;
      let hideTimer = null;

      const clearHide = () => { if (hideTimer) window.clearTimeout(hideTimer); hideTimer = null; };
      const positionDesktop = (card) => {
        const rect = card.getBoundingClientRect();
        const width = Math.min(430, window.innerWidth - 32);
        popover.style.width = `${width}px`;
        const gap = 12;
        let left = rect.right + gap;
        if (left + width > window.innerWidth - 16) left = rect.left - width - gap;
        if (left < 16) left = Math.max(16, Math.min(window.innerWidth - width - 16, rect.left + rect.width / 2 - width / 2));
        let top = rect.top - 12;
        const estimatedHeight = Math.min(popover.scrollHeight || 420, window.innerHeight * .72);
        if (top + estimatedHeight > window.innerHeight - 16) top = Math.max(16, window.innerHeight - estimatedHeight - 16);
        popover.style.left = `${left}px`;
        popover.style.top = `${top}px`;
        popover.style.right = 'auto';
        popover.style.bottom = 'auto';
      };

      const show = (card, lock = false) => {
        clearHide();
        const template = card.querySelector('[data-collaborator-template]');
        if (!template) return;
        content.replaceChildren(template.content.cloneNode(true));
        cards.forEach(c => {
          const active = c === card;
          c.classList.toggle('is-active', active);
          c.setAttribute('aria-expanded', active ? 'true' : 'false');
        });
        activeCard = card;
        pinned = lock;
        popover.classList.add('is-open');
        popover.setAttribute('aria-hidden', 'false');
        backdrop?.classList.toggle('is-open', !canHover);
        if (canHover) requestAnimationFrame(() => positionDesktop(card));
      };

      const hide = (force = false) => {
        if (pinned && !force) return;
        clearHide();
        pinned = false;
        activeCard = null;
        popover.classList.remove('is-open');
        popover.setAttribute('aria-hidden', 'true');
        backdrop?.classList.remove('is-open');
        cards.forEach(c => { c.classList.remove('is-active'); c.setAttribute('aria-expanded', 'false'); });
      };

      cards.forEach(card => {
        if (canHover) {
          card.addEventListener('mouseenter', () => show(card, false));
          card.addEventListener('mouseleave', () => {
            clearHide();
            hideTimer = window.setTimeout(() => hide(false), 180);
          });
          card.addEventListener('focus', () => show(card, false));
        }
        card.addEventListener('click', (event) => {
          event.preventDefault();
          if (activeCard === card && pinned) hide(true);
          else show(card, true);
        });
      });

      popover.addEventListener('mouseenter', clearHide);
      popover.addEventListener('mouseleave', () => {
        if (!pinned && canHover) hideTimer = window.setTimeout(() => hide(false), 180);
      });
      popover.addEventListener('click', (event) => {
        const link = event.target.closest('a');
        if (link) hide(true);
      });
      closeButton?.addEventListener('click', () => hide(true));
      backdrop?.addEventListener('click', () => hide(true));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') hide(true); });
      window.addEventListener('resize', () => { if (activeCard && popover.classList.contains('is-open') && canHover) positionDesktop(activeCard); });
      window.addEventListener('scroll', () => { if (activeCard && popover.classList.contains('is-open') && canHover && !pinned) positionDesktop(activeCard); }, { passive: true });
    })();
  </script>
</MainLayout>
