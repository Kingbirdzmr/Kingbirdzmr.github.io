---
import MainLayout from '../../layouts/MainLayout.astro';import {profile,researchKeywords} from '../../data/profile';import {education} from '../../data/experience';import {publications} from '../../data/publications';import {langPaths,isLang} from '../../utils/routes';import type{Lang}from'../../types';
export function getStaticPaths(){return langPaths();}const param=Astro.params.lang;if(!isLang(param))return Astro.redirect('/en/');const lang:Lang=param;
const h={en:'Curriculum Vitae',zh:'个人简历',ja:'Curriculum Vitae'};const labels={research:{en:'Research Interests',zh:'研究兴趣',ja:'研究分野'},education:{en:'Education',zh:'教育经历',ja:'学歴'},pubs:{en:'Selected Publications',zh:'代表性论文',ja:'主な研究業績'},download:{en:'Download PDF CV',zh:'下载 PDF 简历',ja:'PDF CVをダウンロード'}};
---
<MainLayout {lang} title={`${h[lang]} | ${profile.name}`} description={profile.statement[lang]}><section class="cv-sheet section-shell"><div class="cv-top"><div><p class="eyebrow">CV</p><h1>{profile.displayName[lang]}</h1><p>{profile.nativeName[lang]}</p><strong>{profile.role[lang]}</strong><p>{profile.affiliation[lang]}</p></div>{profile.cvPdf[lang]&&<a class="primary-button" href={profile.cvPdf[lang]}>{labels.download[lang]} ↓</a>}</div><section><h2>{labels.research[lang]}</h2><div class="tag-row large">{researchKeywords.map(k=><span>{k.label[lang]}</span>)}</div></section><section><h2>{labels.education[lang]}</h2>{education.map(e=><div class="cv-row"><time>{e.period[lang]}</time><div><strong>{e.institution[lang]}</strong><p>{e.degree[lang]} · {e.detail?.[lang]}</p></div></div>)}</section><section><h2>{labels.pubs[lang]}</h2>{publications.slice(0,5).map(p=><div class="cv-row"><time>{p.year}</time><div><strong>{p.title[lang]}</strong><p>{p.venue}</p></div></div>)}</section></section></MainLayout>
