---
import MainLayout from '../../layouts/MainLayout.astro';import {education} from '../../data/experience';import {profile} from '../../data/profile';import {langPaths,isLang} from '../../utils/routes';import type{Lang}from'../../types';
export function getStaticPaths(){return langPaths();}const param=Astro.params.lang;if(!isLang(param))return Astro.redirect('/en/');const lang:Lang=param;
const heading={en:'Experience',zh:'经历',ja:'経歴'};const educationTitle={en:'Education',zh:'教育经历',ja:'学歴'};const intro={en:'Academic training and research trajectory.',zh:'学术训练与研究经历。',ja:'学術的な経歴と研究の軌跡。'};
---
<MainLayout {lang} title={`${heading[lang]} | ${profile.name}`} description={intro[lang]}><section class="page-hero section-shell"><p class="eyebrow">EXPERIENCE</p><h1>{heading[lang]}</h1><p>{intro[lang]}</p></section><section class="section-shell timeline"><h2>{educationTitle[lang]}</h2>{education.map((e,i)=><article data-reveal><div class="timeline-dot"></div><time>{e.period}</time><div><h3>{e.institution[lang]}</h3><strong>{e.degree[lang]}</strong>{e.detail&&<p>{e.detail[lang]}</p>}</div></article>)}</section></MainLayout>
